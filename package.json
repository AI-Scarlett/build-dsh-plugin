{
  "name": "dsh-build-plugin",
  "version": "0.5.0",
  "description": "DSH Skill adapter for the build-dsh-plugin development workflow",
  "private": true,
  "type": "module",
  "main": "./src/index.mjs",
  "files": [
    "src",
    "cordis.patch.yml",
    "build-dsh-plugin",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.8 <0.2.0 || 0.1.5-alpha.1 || 0.1.5-alpha.2 || 0.1.5-rc.1 || 0.1.5-rc.2",
      "dshReleases": {
        "0.1.2-alpha.2": "compatible",
        "0.1.2-alpha.3": "compatible",
        "0.1.2-alpha.4": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.1": "compatible",
        "0.1.3-alpha.2": "unknown",
        "0.1.5-alpha.1": "compatible",
        "0.1.5-alpha.2": "compatible",
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible",
        "0.1.6-alpha.1": "unknown"
      }
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "node --test \"test/*.test.mjs\" && node build-dsh-plugin/scripts/test-normalize-brief.mjs && node build-dsh-plugin/scripts/test-marketplace-entry.mjs && node build-dsh-plugin/scripts/test-candidate-entry.mjs && node scripts/verify-distribution.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AI-Scarlett/build-dsh-plugin.git"
  },
  "homepage": "https://dsh.store/build/",
  "license": "MIT"
}
